# Credentials are created inside n8n (Credentials menu), not read from this file.
# This lists what the workflow needs so others know what to set up.

DECODO_AUTH_HEADER=       # Header Auth credential for the Decodo request
GROQ_API_KEY=             # Groq API key for llama-3.3-70b-versatile
GOOGLE_SHEET_ID=          # ID of the Google Sheet used for storage
GOOGLE_OAUTH=             # Google Sheets + Gmail OAuth2 credentials in n8n
DIGEST_RECIPIENT=         # Email address that receives the daily digest
